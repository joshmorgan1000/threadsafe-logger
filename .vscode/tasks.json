{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "cmake",
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "&&",
                "cmake",
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "env": {
                    "NEBULA_ENABLE_APPLE_SIMD": "1",
                    "NEBULA_DHT_BENCH_SECURE": "0"
                }
            }
        },
        {
            "label": "CMake Optimized",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "${workspaceFolder}/build",
                "&&",
                "cmake",
                "-E",
                "make_directory",
                "${workspaceFolder}/build",
                "&&",
                "cmake",
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "&&",
                "cmake",
                "--build",
                "${workspaceFolder}/build",
                "-j16"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
